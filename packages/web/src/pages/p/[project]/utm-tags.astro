---
import type { GetStaticPaths } from "astro";

import { UtmTags } from "@/components/dashboard/project/utm-tags";
import Layout from "@/layouts/layout.astro";

export const getStaticPaths = (() => {
	return [{ params: { project: "project" } }];
}) satisfies GetStaticPaths;
---

<Layout title="UTM tags">
  <UtmTags client:only="react" />
</Layout>

<style>
  /* prevent a flash of scrollbar when navigating to this page, as it always has a scrollbar */
  :global(html) {
    overflow-y: scroll;
  }
</style>
